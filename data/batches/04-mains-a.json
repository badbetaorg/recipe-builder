  {
    "id": "lasagna",
    "title": "Lasagna",
    "category": "Main Dishes",
    "servings": "about 10 servings",
    "prep": ["Preheat oven to 350°F (180°C)", "Have ready a 13 x 9 in. (33 x 22 cm) baking dish"],
    "tree": {
      "do": "bake 350°F (180°C) 25 min.; rest 10 min.",
      "in": [{
        "do": "sprinkle over top",
        "in": [
          {
            "do": "layer: 4 sheets, 3 of ragu & sauce; sauce on top",
            "in": [
              {
                "do": "simmer covered 1-1/2 hr., uncovered 30 min.",
                "in": [{
                  "do": "add",
                  "in": [
                    {
                      "do": "brown, breaking up",
                      "in": [
                        {
                          "do": "sauté 10 min. without browning",
                          "in": [
                            "1 Tbs. (15 mL) olive oil",
                            { "do": "mince", "in": ["2 garlic cloves"] },
                            { "do": "finely chop", "in": ["1 onion"] },
                            { "do": "finely dice", "in": ["1 celery stalk"] },
                            { "do": "finely dice", "in": ["1 medium carrot"] }
                          ]
                        },
                        "2 lb. (1 kg) ground beef"
                      ]
                    },
                    "28 oz. (800 g) canned crushed tomatoes",
                    "1/4 cup (65 g) tomato paste",
                    "1 cup (250 mL) dry red wine",
                    { "do": "crumble", "in": ["3 beef bouillon cubes"] },
                    "2 bay leaves",
                    "1/2 tsp. each dried thyme and oregano",
                    "1/2 tsp. each salt and black pepper"
                  ]
                }]
              },
              {
                "do": "off heat, stir in until melted",
                "in": [
                  {
                    "do": "whisk in gradually; stir 5–8 min. to thicken",
                    "in": [
                      {
                        "do": "cook 1 min.",
                        "in": [
                          { "do": "melt", "in": ["4 Tbs. (60 g) butter"] },
                          "1/2 cup (65 g) all-purpose flour"
                        ]
                      },
                      "4 cups (1 L) milk"
                    ]
                  },
                  { "do": "shred", "in": ["2 cups (200 g) Gruyère or Colby cheese"] }
                ]
              },
              "12 oz. (350 g) fresh lasagna sheets"
            ]
          },
          { "do": "shred", "in": ["1-1/2 cups (150 g) mozzarella"] }
        ]
      }]
    },
    "notes": ["Spread a little ragu on the base of the dish before the first sheets.", "8 oz. (250 g) dried lasagna sheets can replace fresh.", "The original also seasons the ragu with 2 tsp. Worcestershire sauce and the cheese sauce with a pinch of nutmeg."],
