  {
    "id": "buttermilk-pancakes",
    "title": "Buttermilk Pancakes",
    "category": "Breakfast",
    "servings": "14 to 16 medium (4-inch) pancakes",
    "prep": [
      "Heat a griddle to 350°F (175°C) or a skillet over medium heat",
      "Lightly grease the griddle"
    ],
    "tree": {
      "do": "flip; cook 1–2 min. more",
      "in": [
        {
          "do": "cook until bubbles form, 1–2 min.",
          "in": [
            {
              "do": "scoop 1/4 cup (60 mL) portions",
              "in": [
                {
                  "do": "rest 15 min.",
                  "in": [
                    {
                      "do": "stir until fairly smooth",
                      "in": [
                        {
                          "do": "whisk",
                          "in": [
                            "2 cups (240 g) all-purpose flour",
                            "3 Tbs. (35 g) sugar",
                            "1 tsp. (4 g) baking powder",
                            "1 tsp. (6 g) baking soda",
                            "1/2 tsp. (3 g) salt"
                          ]
                        },
                        {
                          "do": "whisk",
                          "in": [
                            "1 large egg",
                            "2 cups (454 g) buttermilk",
                            {
                              "do": "melt",
                              "in": [
                                "2 Tbs. (28 g) butter"
                              ]
                            },
                            "1-1/2 tsp. (7 mL) vanilla extract"
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "notes": [
      "A few small lumps in the batter are fine.",
      "Hold finished pancakes in a 250°F (120°C) oven if needed."
