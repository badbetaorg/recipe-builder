  {
    "id": "caesar-salad",
    "title": "Caesar Salad",
    "category": "Salads & Sides",
    "servings": "4 side salads",
    "prep": [
      "Preheat oven to 350°F (175°C)"
    ],
    "tree": {
      "do": "drizzle; toss gently",
      "in": [
        {
          "do": "top",
          "in": [
            {
              "do": "rinse, dry & chop",
              "in": [
                "1 large head romaine (or 2 small)"
              ]
            },
            "1/3 cup (30 g) shaved Parmesan",
            {
              "do": "cool",
              "in": [
                {
                  "do": "bake 350°F (175°C) 10-12 min.",
                  "in": [
                    {
                      "do": "drizzle & toss",
                      "in": [
                        {
                          "do": "slice 1/4 in. (6 mm) thick",
                          "in": [
                            "1/2 French baguette"
                          ]
                        },
                        {
                          "do": "stir together",
                          "in": [
                            "3 Tbs. (45 mL) extra-virgin olive oil, for croutons",
                            "1 tsp. (3 g) minced garlic, for croutons"
                          ]
                        },
                        "2 Tbs. (10 g) grated Parmesan, for croutons"
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "do": "season",
          "in": [
            {
              "do": "drizzle in, whisking constantly",
              "in": [
                {
                  "do": "whisk",
                  "in": [
                    {
                      "do": "mince",
                      "in": [
                        "2 small garlic cloves, for dressing"
                      ]
                    },
                    "2 tsp. (10 g) Dijon mustard",
                    "1 tsp. (5 mL) Worcestershire sauce",
                    "2 tsp. (10 mL) fresh lemon juice",
                    "1-1/2 tsp. (7 mL) red wine vinegar"
                  ]
                },
                "1/3 cup (80 mL) extra-virgin olive oil, for dressing"
              ]
            },
            "1/2 tsp. (3 g) sea salt",
            "1/8 tsp. black pepper"
          ]
        }
      ]
    },
    "notes": [
      "Dress just before serving."
    ],
    "source": {
      "name": "Natasha's Kitchen",
      "url": "https://natashaskitchen.com/caesar-salad-recipe/"
    }
