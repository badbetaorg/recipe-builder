[
  {
    "id": "chicken-noodle-soup",
    "title": "Chicken Noodle Soup",
    "category": "Soups & Stews",
    "servings": "about 6 servings",
    "tree": {
      "do": "return shredded chicken; stir in",
      "in": [
        {
          "do": "remove chicken; add noodles, cook 6-10 min.",
          "in": [
            {
              "do": "simmer partially covered 20 min.",
              "in": [
                {
                  "do": "bring to gentle simmer; season",
                  "in": [
                    {
                      "do": "sauté 1 min.",
                      "in": [
                        {
                          "do": "sauté 5 min.",
                          "in": [
                            "2 Tbs. (28 g) butter",
                            {
                              "do": "chop",
                              "in": [
                                "1 large onion"
                              ]
                            },
                            {
                              "do": "chop",
                              "in": [
                                "2 large carrots"
                              ]
                            },
                            {
                              "do": "chop",
                              "in": [
                                "2 ribs celery"
                              ]
                            }
                          ]
                        },
                        {
                          "do": "mince",
                          "in": [
                            "4 garlic cloves"
                          ]
                        },
                        "2 bay leaves",
                        "3 sprigs fresh thyme (or 1/2 tsp. dried)"
                      ]
                    },
                    "8 cups (1.9 L) low-sodium chicken stock",
                    "salt and pepper to taste"
                  ]
                },
                "1 lb. (450 g) boneless, skinless chicken thighs"
              ]
            },
            "5 oz. (140 g) egg noodles"
          ]
        },
        {
          "do": "finely chop",
          "in": [
            "1/4 cup (15 g) fresh parsley"
          ]
        }
      ]
    },
    "notes": [
      "Shred the chicken with two forks while the noodles cook.",
      "Add a splash of stock if the soup reduces too much."
    ],
    "source": {
      "name": "Inspired Taste",
      "url": "https://www.inspiredtaste.net/37475/homemade-chicken-noodle-soup-recipe/"
    }
  },
  {
    "id": "tomato-soup",
    "title": "Tomato Soup",
    "category": "Soups & Stews",
    "servings": "about 8 cups",
    "tree": {
      "do": "stir in; simmer; season to taste",
      "in": [
        {
          "do": "blend smooth",
          "in": [
            {
              "do": "boil, then simmer partially covered 10 min.",
              "in": [
                {
                  "do": "sauté 1 min.",
                  "in": [
                    {
                      "do": "sauté 10-12 min. until golden",
                      "in": [
                        "4 Tbs. (57 g) unsalted butter",
                        {
                          "do": "finely chop",
                          "in": [
                            "2 yellow onions"
                          ]
                        }
                      ]
                    },
                    {
                      "do": "mince",
                      "in": [
                        "3 garlic cloves"
                      ]
                    }
                  ]
                },
                "2 cans (28 oz./794 g each) crushed tomatoes",
                "2 cups (475 mL) chicken stock",
                {
                  "do": "chop",
                  "in": [
                    "1/4 cup (10 g) fresh basil"
                  ]
                },
                "1 Tbs. (12 g) sugar",
                "1/2 tsp. (1 g) black pepper"
              ]
            }
          ]
        },
        "1/2 cup (120 mL) heavy cream",
        {
          "do": "grate",
          "in": [
            "1/3 cup (30 g) Parmesan"
          ]
        }
      ]
    },
    "notes": [
      "Use a nonreactive pot.",
      "Skip blending for a chunky soup. Top with extra Parmesan and basil."
    ],
    "source": {
      "name": "Natasha's Kitchen",
      "url": "https://natashaskitchen.com/tomato-soup-recipe/"
    }
  },
  {
    "id": "minestrone",
    "title": "Minestrone",
    "category": "Soups & Stews",
    "servings": "about 6 servings",
    "tree": {
      "do": "stir in; season to taste",
      "in": [
        {
          "do": "purée 1 cup; stir back in",
          "in": [
            {
              "do": "boil, then simmer covered 15 min.",
              "in": [
                {
                  "do": "boil, then simmer covered 20 min.",
                  "in": [
                    {
                      "do": "sauté 1 min.",
                      "in": [
                        {
                          "do": "sauté 6-8 min.",
                          "in": [
                            "2 Tbs. (28 g) unsalted butter",
                            "2 Tbs. (30 mL) extra-virgin olive oil",
                            {
                              "do": "chop",
                              "in": [
                                "1 large yellow onion"
                              ]
                            },
                            {
                              "do": "dice",
                              "in": [
                                "2 medium celery stalks"
                              ]
                            },
                            {
                              "do": "dice",
                              "in": [
                                "2 medium carrots"
                              ]
                            }
                          ]
                        },
                        {
                          "do": "mince",
                          "in": [
                            "4 garlic cloves"
                          ]
                        }
                      ]
                    },
                    "6 cups (1.4 L) chicken stock",
                    "1 can (14.5 oz./411 g) diced tomatoes",
                    "2 Tbs. (32 g) tomato paste",
                    {
                      "do": "drain & rinse",
                      "in": [
                        "1 can (15 oz./425 g) cannellini beans"
                      ]
                    },
                    {
                      "do": "peel; cut 1/2 in. (1 cm) cubes",
                      "in": [
                        "1 large russet potato"
                      ]
                    },
                    "1-1/2 tsp. (9 g) salt",
                    "1/2 tsp. (2 g) sugar",
                    "1 tsp. (1 g) dried thyme",
                    "1/2 tsp. (0.5 g) dried oregano",
                    "1/4 tsp. (0.5 g) black pepper"
                  ]
                },
                "3/4 cup (85 g) small pasta (ditalini or elbows)",
                {
                  "do": "dice",
                  "in": [
                    "1 medium zucchini"
                  ]
                }
              ]
            }
          ]
        },
        "1 Tbs. (15 mL) extra-virgin olive oil, to finish",
        "1/3 cup (30 g) grated Pecorino Romano or Parmesan",
        {
          "do": "chop",
          "in": [
            "2 Tbs. (5 g) fresh basil"
          ]
        }
      ]
    },
    "notes": [
      "The purée gives the broth more body.",
      "Serve topped with more grated cheese."
    ],
    "source": {
      "name": "Once Upon a Chef",
      "url": "https://www.onceuponachef.com/recipes/minestrone-soup.html"
    }
  },
  {
    "id": "french-onion-soup",
    "title": "French Onion Soup",
    "category": "Soups & Stews",
    "servings": "about 6 servings",
    "prep": [
      "Preheat oven to 400°F (205°C)"
    ],
    "tree": {
      "do": "ladle into bowls; top with cheese & toasts",
      "in": [
        {
          "do": "season to taste",
          "in": [
            {
              "do": "simmer partially covered 30 min.",
              "in": [
                {
                  "do": "deglaze; cook 3 min.",
                  "in": [
                    {
                      "do": "sauté 1 min.",
                      "in": [
                        {
                          "do": "caramelize 30-40 min.",
                          "in": [
                            {
                              "do": "sauté uncovered 10 min.",
                              "in": [
                                "2 Tbs. (30 mL) olive oil",
                                "2 Tbs. (28 g) unsalted butter",
                                {
                                  "do": "halve; thinly slice",
                                  "in": [
                                    "3 lb. (1.4 kg) yellow onions (about 6 large)"
                                  ]
                                }
                              ]
                            },
                            "1/2 tsp. (2 g) sugar"
                          ]
                        },
                        {
                          "do": "mince",
                          "in": [
                            "2 garlic cloves"
                          ]
                        }
                      ]
                    },
                    "1/2 cup (120 mL) dry sherry"
                  ]
                },
                "8 cups (1.9 L) beef stock",
                "1 bay leaf",
                "3 sprigs fresh thyme",
                "1 tsp. (6 g) salt"
              ]
            },
            "1/2 tsp. (3 g) salt and 1/2 tsp. (1 g) black pepper, to taste"
          ]
        },
        "4 oz. (113 g) Gruyère, shredded, for topping",
        {
          "do": "top with cheese; broil 2-3 min.",
          "in": [
            {
              "do": "bake 400°F (205°C) 6-8 min.",
              "in": [
                {
                  "do": "brush both sides",
                  "in": [
                    "12 slices (1/2 in./1 cm thick) baguette",
                    "about 2 Tbs. (30 mL) olive oil, for brushing"
                  ]
                }
              ]
            },
            "4 oz. (113 g) Gruyère, shredded, for toasts"
          ]
        }
      ]
    },
    "notes": [
      "Stir the onions more often near the end of caramelizing.",
      "Dry vermouth or dry white wine can replace the sherry."
    ],
    "source": {
      "name": "Natasha's Kitchen",
      "url": "https://natashaskitchen.com/french-onion-soup/"
    }
  },
  {
