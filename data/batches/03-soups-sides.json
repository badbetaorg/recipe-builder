    "id": "beef-stew",
    "title": "Beef Stew",
    "category": "Soups & Stews",
    "servings": "about 6 servings",
    "prep": [
      "Preheat oven to 325°F (165°C), rack in lower-middle position"
    ],
    "tree": {
      "do": "remove bay leaf; season; garnish",
      "in": [
        {
          "do": "bake covered 1 hr. more",
          "in": [
            {
              "do": "boil, then braise covered 325°F (165°C) 2 hr.",
              "in": [
                {
                  "do": "stir in paste 1 min.; add flour, stir 1-2 min.",
                  "in": [
                    {
                      "do": "cook 5 min., scraping pan",
                      "in": [
                        {
                          "do": "brown in 3 batches, 5 min. each",
                          "in": [
                            {
                              "do": "pat dry; season",
                              "in": [
                                {
                                  "do": "cut 1-1/2 in. (4 cm) pieces",
                                  "in": [
                                    "3 lb. (1.4 kg) boneless beef chuck"
                                  ]
                                },
                                "2 tsp. (12 g) salt",
                                "1 tsp. (2 g) black pepper"
                              ]
                            },
                            "3 Tbs. (45 mL) olive oil"
                          ]
                        },
                        {
                          "do": "cut 1 in. (2.5 cm) chunks",
                          "in": [
                            "2 medium yellow onions"
                          ]
                        },
                        {
                          "do": "smash & peel",
                          "in": [
                            "7 garlic cloves"
                          ]
                        },
                        "2 Tbs. (30 mL) balsamic vinegar"
                      ]
                    },
                    "1-1/2 Tbs. (24 g) tomato paste",
                    "1/4 cup (31 g) all-purpose flour"
                  ]
                },
                "2 cups (475 mL) dry red wine",
                "2 cups (475 mL) beef broth",
                "2 cups (475 mL) water",
                "1 bay leaf",
                "1/2 tsp. (0.5 g) dried thyme",
                "1-1/2 tsp. (6 g) sugar"
              ]
            },
            {
              "do": "peel; cut 1 in. (2.5 cm) diagonal chunks",
              "in": [
