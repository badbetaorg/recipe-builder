{
  "name": "Recipe Grid",
  "short_name": "Recipe Grid",
  "description": "A cookbook where every recipe is one sheet: ingredients down the side, each step spanning what it combines.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#eceae4",
  "theme_color": "#17181a",
  "categories": ["food", "lifestyle"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New recipe", "url": "./index.html#/new", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "My recipes", "url": "./index.html#/mine", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
